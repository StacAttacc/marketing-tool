{
  "name": "budget-internal-tool",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky || true",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "db:seed-admin": "tsx --tsconfig tsconfig.scripts.json server/database/scripts/seed-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@better-auth/drizzle-adapter": "^1.5.3",
    "@neondatabase/serverless": "^1.0.2",
    "@nuxt/eslint": "^1.12.1",
    "@nuxt/icon": "^2.2.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@orpc/client": "^1.13.4",
    "@orpc/server": "^1.13.4",
    "@orpc/tanstack-query": "^1.13.4",
"@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/vue-query": "^5.92.9",
    "apexcharts": "^5.3.6",
    "better-auth": "^1.4.13",
    "daisyui": "^5.5.14",
    "drizzle-orm": "^0.45.1",
    "eslint": "^9.39.2",
    "nuxt": "^4.1.3",
    "pg": "^8.17.2",
    "tailwindcss": "^4.1.18",
    "v-calendar": "^3.1.2",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4",
    "vue3-apexcharts": "^1.10.0",
    "ws": "^8.19.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@types/pg": "^8.16.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.4",
    "eslint-plugin-format": "^1.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "^5.9.3",
    "vite-plugin-eslint2": "^5.0.4",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "*": "npm run lint"
  }
}
